# ==== Backend environment (copy to .env and edit) ====
# This file is committed. NEVER put a real secret here.

# development | production
# Anything not in {development,dev,local,test} enables strict invariants:
# a strong SECRET_KEY becomes mandatory and demo seeding is refused.
APP_ENV=development

# Secret used to sign JWTs. REQUIRED in production — generate with:
#   openssl rand -hex 32
# Leave empty here on purpose: the placeholder that used to live in this file
# was a real signing key in every clone that copied it verbatim.
SECRET_KEY=
# HS256 | HS384 | HS512 only (asymmetric/none are rejected at startup).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bind address. Use 127.0.0.1 locally; 0.0.0.0 only in a container or behind
# a reverse proxy that terminates TLS.
HOST=127.0.0.1
# Backend port (8080 suele estar tomado por Apache/XAMPP en Windows)
PORT=8081

# CORS origin(s) of the frontend. Comma-separated for multiple.
# Must be exact origins — wildcards are not accepted with credentials.
FRONTEND_ORIGIN=http://localhost:5471

# SQLite file (relative to backend/)
DATABASE_URL=sqlite:///./database.db

# Seed demo users (cliente/empleado/gerente/desarrollador) with the
# well-known passwords documented in the README. Development only.
SEED_DEMO_USERS=true

# Security/audit log verbosity
LOG_LEVEL=INFO
