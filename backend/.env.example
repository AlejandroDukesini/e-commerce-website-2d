# ==== Backend environment (copy to .env and edit) ====
# Secret used to sign JWTs. CHANGE THIS in production (openssl rand -hex 32).
SECRET_KEY=change-me-super-secret-key-please-rotate-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backend port (8080 suele estar tomado por Apache/XAMPP en Windows)
PORT=8081

# CORS origin of the Vite frontend
FRONTEND_ORIGIN=http://localhost:5471

# SQLite file (relative to backend/)
DATABASE_URL=sqlite:///./database.db

# Seed a default admin/dev user on first boot
SEED_DEMO_USERS=true
