# --- Secrets / local environment ---------------------------------------
# Ignore every .env variant by default and re-allow only the committed
# templates. Previously only `.env.local` was ignored, so a developer adding
# a real key to `.env` would have committed it silently.
.env
.env.*
!.env.example
!*.env.example

# backend
backend/__pycache__/
backend/**/__pycache__/
backend/.env
backend/database.db

