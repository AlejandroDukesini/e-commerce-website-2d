# ==== Frontend environment (copy to .env) ====
#
# WARNING: Vite inlines every VITE_* variable into the JavaScript bundle that
# is shipped to the browser. They are PUBLIC. Never put an API secret, private
# key or database credential behind a VITE_ prefix — server-side secrets belong
# in backend/.env, which is never bundled.

# In dev the /api proxy handles this; an absolute URL is the prod fallback.
VITE_API_URL=/api
VITE_SITE_NAME=Autos del Camino
VITE_SITE_URL=http://localhost:5471

# Analítica (opcional). Si se deja vacío, GA4 se omite sin errores.
# El script SOLO se carga tras consentimiento de la categoría "analíticas".
VITE_GA_MEASUREMENT_ID=

# Set to "true" to bind the dev server to all network interfaces for LAN
# testing. Off by default: the Vite dev server is unauthenticated.
# VITE_EXPOSE_LAN=false
